ANTHROPIC_API_KEY=
# Primary Gemini credential used by Jarvis.
GEMINI_API_KEY=
# Optional compatibility alias; use this only if your existing setup names it this way.
# GOOGLE_API_KEY=
OPENWEATHER_API_KEY=
JARVIS_WAKE_WORD=jarvis
JARVIS_MODEL=gemini-flash-latest
JARVIS_MODEL_TIMEOUT_MS=20000
JARVIS_TTS_VOICE=en-GB-RyanNeural
JARVIS_TTS_RATE=+0%
JARVIS_TTS_PITCH=-2Hz
JARVIS_SAMPLE_RATE=16000
JARVIS_STT_MODEL=tiny.en
JARVIS_VAD_SILENCE_LIMIT=1.0
JARVIS_VAD_NO_SPEECH_TIMEOUT=2.0
JARVIS_RECORD_SECONDS=8
JARVIS_SPLASH_DURATION_MS=3500
JARVIS_DB_PATH=jarvis_history.sqlite3
